def read_arch_input_rows(boq_ss_key: str) -> List[Dict[str, Any]]:
    ws = gc.open_by_key(boq_ss_key).worksheet(CONFIG["arch_input_sheet"])
    headers = get_headers(ws)
    data = ws.get_all_values()[1:]

    idx = detect_col_indices(headers, {
        "level": r"levels?",
        "area": r"^area$",
        "code": r"^code$",
        "spec": r"specification",
        "qty": r"^qty$",
        "unit": r"^unit$",
        "model": r"model\s*no",
        "automation": r"automation",
        "track_shape": r"magnetic\s*track.*shape",
        "track_qty": r"magnetic\s*track.*quantity",
        "track_c2c": r"ceiling\s*to\s*ceiling",
        "track_c2w": r"ceiling\s*to\s*wall",
        "oem_desc": r"oem.*description",
        "oem_price": r"oem.*unit\s*price",
    })

    rows = []
    for row in data:
        level = row[idx["level"]] if idx["level"] >= 0 and idx["level"] < len(row) else ""
        if not safe_str(level):
            continue

        def val(k):
            i = idx.get(k, -1)
            return row[i] if i >= 0 and i < len(row) else ""

        rows.append({
            "level": val("level"),
            "area": val("area") or val("code"),
            "code": val("code"),
            "specification": val("spec"),
            "qty": float(val("qty") or 0),
            "unit": val("unit") or "pcs",
            "model_no": val("model"),
            "automation": val("automation"),
            "track_shape": val("track_shape"),
            "track_qty": float(val("track_qty") or 0),
            "track_c2c": float(val("track_c2c") or 0),
            "track_c2w": float(val("track_c2w") or 0),
            "oem_desc": val("oem_desc"),
            "oem_price": float(val("oem_price") or 0),
        })
    return rows


