def parse_track_spec_type_len(s: str) -> Tuple[str, int]:
    t = safe_str(s).lower()
    track_type = "Surface"
    if "pre" in t and "install" in t:
        track_type = "Embedded"
    elif "plaster" in t or "recess" in t:
        track_type = "Recessed"
    elif "surface" in t:
        track_type = "Surface"

    length = 1
    if re.search(r"\b2\s*m\b|2000\s*mm|(^|[^0-9])2m([^0-9]|$)", t, re.I):
        length = 2
    elif re.search(r"\b1\s*m\b|1000\s*mm|(^|[^0-9])1m([^0-9]|$)", t, re.I):
        length = 1

    return track_type, length


def parse_watt_from_power(power_str: str) -> float:
    m = re.search(r"(\d+(\.\d+)?)\s*w", safe_str(power_str), re.I)
    return float(m.group(1)) if m else 0.0


def choose_psus(total_w: float):
    packs = []
    if total_w <= 0:
        return packs

    remaining = total_w
    n200 = int(remaining // 200)
    if n200 > 0:
        packs.append({"opt": PSU_200W, "qty": n200})
        remaining -= n200 * 200

    if remaining > 0:
        packs.append({"opt": PSU_200W if remaining > 100 else PSU_100W, "qty": 1})

    return packs


def build_desc(product: Dict[str, Any], brand: str, unit: str) -> str:
    if not product:
        return ""

    out = []
    if product.get("power"):
        out.append(f"Power: {product['power']}" + (" per meter" if unit == "m" else ""))
    if product.get("cct"):
        out.append(f"LED Temperature: {product['cct']}K")
    if product.get("led_brand"):
        out.append(f"LED Brand: {product['led_brand']}")
    if product.get("control_gear"):
        out.append(f"Control Gear: {product['control_gear']}")
    if product.get("ip_rating"):
        out.append(f"IP Rating: {product['ip_rating']}")
    if product.get("body"):
        out.append(f"Body Colour: {product['body']}")
    out.append(f"Lighting Brand: {brand}")
    if product.get("warranty"):
        out.append(f"Warranty Period: {product['warranty']}")
    return "\n".join(out)


# ==========================================================
# GENERATE BREAKDOWN
# ==========================================================
def generate_arch_breakdown_rows(
    boq_ss_key: str,
    price_map: Dict[str, Dict[str, Any]],
    oem_map: Dict[str, Dict[str, Any]]
) -> Tuple[List[List[Any]], float]:
    helper_rows = read_arch_input_rows(boq_ss_key)
    rows_out = []
    grand_total = 0.0
    serial = 1

    def add_line(level, area, model_no, product_name, image, brand, desc, unit, qty, unit_price):
        nonlocal serial, grand_total, rows_out
        total_price = qty * unit_price
        rows_out.append([
            serial, level, area, model_no, product_name, image, brand, desc, unit, qty, unit_price, total_price
        ])
        serial += 1
        grand_total += total_price

    def push_sku(model, qty, level, area, unit_cell):
        if not qty or qty <= 0:
            return
        rec = price_map.get(model)
        if not rec:
            return
        add_line(
            level=level,
            area=area,
            model_no=model,
            product_name=rec.get("product_name", model),
            image=rec.get("photo", ""),
            brand=rec.get("brand", "Moorgen"),
            desc=build_desc(rec, rec.get("brand", "Moorgen"), unit_cell),
            unit=unit_cell,
            qty=qty,
            unit_price=rec.get("price", 0.0),
        )

    for r in helper_rows:
        level = safe_str(r["level"])
        area = safe_str(r["area"])
        spec = safe_str(r["specification"])
        qty_d = float(r["qty"] or 0)
        unit_cell = safe_str(r["unit"]) or "pcs"
        model_no = safe_str(r["model_no"])
        track_spec = safe_str(r["track_shape"])
        track_qty = float(r["track_qty"] or 0)
        c2c = float(r["track_c2c"] or 0)
        c2w = float(r["track_c2w"] or 0)
        oem_desc = safe_str(r["oem_desc"])
        oem_price = float(r["oem_price"] or 0)

        is_track = bool(track_spec)

        # main item
        if model_no and model_no in price_map:
            rec = price_map[model_no]
            add_line(
                level=level,
                area=area,
                model_no=model_no,
                product_name=rec.get("product_name", model_no),
                image=rec.get("photo", ""),
                brand=rec.get("brand", "Moorgen"),
                desc=build_desc(rec, rec.get("brand", "Moorgen"), unit_cell),
                unit=unit_cell,
                qty=qty_d,
                unit_price=rec.get("price", 0.0),
            )
        else:
            oem_name = oem_desc.split("\n")[0] if oem_desc else "OEM Item"
            oem_photo = oem_map.get(oem_name, {}).get("photo", "")
            add_line(
                level=level,
                area=area,
                model_no=model_no,
                product_name=oem_name,
                image=oem_photo,
                brand="OEM",
                desc=oem_desc,
                unit=unit_cell,
                qty=qty_d,
                unit_price=oem_price,
            )

        # track rails + accessories
        if is_track and track_qty > 0:
            track_type, rail_len = parse_track_spec_type_len(track_spec)
            base_model = TRACK_BASE_SKU.get(track_type, {}).get(str(rail_len), "")
            cfg = TRACK_CONFIG.get(track_type, TRACK_CONFIG["Surface"])

            if base_model and model_no.lower() != base_model.lower():
                push_sku(base_model, track_qty, level, area, unit_cell)

            push_sku(cfg["powerBox"], track_qty, level, area, unit_cell)
            push_sku(STRAIGHT_SPLICE, max(track_qty - 1, 0), level, area, unit_cell)
            push_sku(CORNER_SPLICE, c2c + c2w, level, area, unit_cell)

            if c2c > 0:
                push_sku(cfg["flat_jointers"], c2c, level, area, unit_cell)
            if c2w > 0:
                push_sku(cfg["facade_jointers"], c2w, level, area, unit_cell)

        # PSU logic
        if is_track:
            per_head_w = 0.0
            if model_no and model_no in price_map:
                per_head_w = parse_watt_from_power(price_map[model_no].get("power", ""))
            if not per_head_w:
                m = re.search(r"(\d+(\.\d+)?)\s*w", spec, re.I)
                if m:
                    per_head_w = float(m.group(1))

            total_w = per_head_w * qty_d
            for p in choose_psus(total_w):
                add_line(
                    level=level,
                    area=area,
                    model_no=p["opt"]["model"],
                    product_name=p["opt"]["name"] + (f" (sized for ~{round(total_w)}W)" if total_w > 0 else ""),
                    image="",
                    brand="OEM",
                    desc="",
                    unit=unit_cell or "pc",
                    qty=p["qty"],
                    unit_price=p["opt"]["price"],
                )

    return rows_out, grand_total


