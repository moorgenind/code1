    if rows:
        ws.update(f"A{header_row+1}:L{header_row+len(rows)}", rows, value_input_option="USER_ENTERED")

        total_row = header_row + len(rows) + 1
        ws.update(f"K{total_row}", [["Grand Total"]])
        ws.update(f"L{total_row}", [[grand_total]], value_input_option="USER_ENTERED")


def write_summary(boq_ss_key: str, grand_total: float):
    ss = gc.open_by_key(boq_ss_key)
    ws = ss.worksheet(CONFIG["summary_sheet"])

    gst = round(grand_total * 0.18, 2)
    total = round(grand_total + gst, 2)

    # Simple fixed layout
    updates = [
        ("B5", "Project Name:"),
        ("C5", f"=IFERROR(VLOOKUP(\"Client_Name\",'{CONFIG['project_details_sheet']}'!A:B,2,FALSE),\"\")"),
        ("B6", "System Category: Architectural"),
        ("B7", f"Date: {datetime.now().strftime('%B %d, %Y')}"),
        ("B10", "Architectural Lighting"),
        ("C10", grand_total),
        ("B11", "Total"),
        ("C11", grand_total),
        ("B12", "18% GST"),
        ("C12", gst),
        ("B13", "Grand Total"),
        ("C13", total),
    ]

    for cell, value in updates:
        ws.update(cell, [[value]], value_input_option="USER_ENTERED")


