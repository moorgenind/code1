    headers = [clean_header(h) for h in rows[0]]
    ix = detect_col_indices(headers, {
        "name": r"oem\s*product|product\s*name|description",
        "photo": r"product\s*photo|photo|image",
    })

    out = {}
    for row in rows[1:]:
        name = safe_str(row[ix["name"]]) if ix["name"] >= 0 and ix["name"] < len(row) else ""
        if not name:
            continue
        photo = row[ix["photo"]] if ix["photo"] >= 0 and ix["photo"] < len(row) else ""
        out[name] = {"name": name, "photo": photo}
    return out


