def detect_col_indices(headers: List[str], patterns: Dict[str, str]) -> Dict[str, int]:
    out = {}
    for key, pattern in patterns.items():
        rgx = re.compile(pattern, re.I)
        idx = next((i for i, h in enumerate(headers) if rgx.search(str(h))), -1)
        out[key] = idx
    return out


def load_arch_price_map() -> Dict[str, Dict[str, Any]]:
    _, ws = get_ws_by_spreadsheet_id(CONFIG["price_lists_spreadsheet_id"], CONFIG["price_arch_sheet"])
    headers = get_headers(ws)

    patterns = {
        "model": r"model[_\s\-]*no\.?",
        "name": r"product\s*name",
        "photo": r"product\s*photo",
        "brand": r"family\s*name",
        "price": r"mrp[_\s\-]*gst|dealer[_\s\-]*mrp|mrp",
        "desc": r"^desc$|description",
        "power": r"power",
        "cct": r"color\s*temperature",
        "beam": r"beam\s*angle",
        "cri": r"color\s*rendering",
        "body": r"^body$|body\s*color",
        "driver": r"remarks|driver",
        "led_brand": r"led\s*brand",
        "control_gear": r"control\s*gear",
        "ip": r"ip\s*rating",
        "warranty": r"warranty",
        "type": r"^type$",
        "unit": r"^unit$",
    }
    ix = detect_col_indices(headers, patterns)

    data = ws.get_all_values()[1:]
    out = {}

    for row in data:
        model_no = safe_str(row[ix["model"]]) if ix["model"] >= 0 and ix["model"] < len(row) else ""
        if not model_no:
            continue

        def getv(k):
            i = ix.get(k, -1)
            return row[i] if i >= 0 and i < len(row) else ""

        price_raw = getv("price")
        try:
            price = float(str(price_raw).replace(",", "").replace("₹", "").strip() or 0)
        except Exception:
            price = 0.0

        out[model_no] = {
            "model_no": model_no,
            "product_name": getv("name"),
            "photo": getv("photo"),
            "brand": getv("brand") or "Moorgen",
            "price": price,
            "desc": getv("desc"),
            "power": getv("power"),
            "cct": getv("cct"),
            "beam": getv("beam"),
            "cri": getv("cri"),
            "body": getv("body"),
            "driver": getv("driver"),
            "led_brand": getv("led_brand"),
            "control_gear": getv("control_gear"),
            "ip_rating": getv("ip"),
            "warranty": getv("warranty"),
            "type": getv("type"),
            "unit": getv("unit") or "pcs",
        }
    return out


def load_oem_map() -> Dict[str, Dict[str, Any]]:
    _, ws = get_ws_by_spreadsheet_id(CONFIG["price_lists_spreadsheet_id"], CONFIG["price_oem_sheet"])
    rows = ws.get_all_values()
