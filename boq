# ==========================================================
# CREATE STAGE
# ==========================================================
def create_architectural_boq_file(
    request_id: Optional[str],
    row_number: Optional[int],
    user_name: str
) -> Dict[str, Any]:
    crm_ss, queue_ws = get_ws_by_spreadsheet_name(
        CONFIG["crm_spreadsheet_name"],
        CONFIG["crm_boq_queue_sheet"]
    )
    queue_row_num, row = find_row_by_request_or_row(queue_ws, request_id=request_id, row_number=row_number)

    lead_id = safe_str(row.get("Lead_ID"))
    request_id_val = safe_str(row.get("Request_ID"))
    client_name = safe_str(row.get("Client_Name"))
    category = safe_str(row.get("Category")) or "Architectural Lighting"
    boq_type = safe_str(row.get("BOQ_Type")) or "Tentative"
    scope = safe_str(row.get("Scope")) or category
    prepared_by = safe_str(row.get("Prepared_By")) or user_name
    dimming_type = safe_str(row.get("Dimming_Type"))
    boq_link_existing = safe_str(row.get("BOQ_Link"))

    if boq_link_existing:
        return {
            "success": True,
            "message": "BOQ file already exists for this request.",
            "boq_link": boq_link_existing,
            "request_id": request_id_val,
        }

    # Need project folder from CRM queue row or later from Leads/Projects if you add it there.
    # For now we assume BOQ_Request_Queue has BOQ_Link etc and also project folder comes from Notes or linked elsewhere.
    # Since you said the lead/project folder already exists, we’ll fetch it from Leads later if needed.
    leads_ws = gc.open(CONFIG["crm_spreadsheet_name"]).worksheet("Leads")
    leads_records = leads_ws.get_all_records()

    drive_folder_link = ""
    for lead in leads_records:
        if safe_str(lead.get("Lead_ID")) == lead_id:
            drive_folder_link = safe_str(lead.get("Drive_Folder_Link"))
            break

    folder_id = parse_drive_id(drive_folder_link)
    if not folder_id:
        raise ValueError("Could not find Drive_Folder_Link for this lead.")

    quotes_folder = get_or_create_subfolder(folder_id, CONFIG["quotes_subfolder_name"])

    revision_no = next_revision_no(queue_ws, lead_id, category)
    boq_id = build_id("BOQ-ARCH", lead_id, revision_no)
    file_name = f"{lead_id}_{slugify(client_name)}_ARCH_BOQ_R{revision_no}"

    write_queue_processing(queue_ws, queue_row_num)

    copied = copy_template_to_folder(
        template_file_id=CONFIG["boq_template_spreadsheet_id"],
        target_folder_id=quotes_folder["id"],
        new_name=file_name
    )

    write_project_details(
        copied["id"],
        {
            "Lead_ID": lead_id,
            "Request_ID": request_id_val,
            "Client_Name": client_name,
            "BOQ_Type": boq_type,
            "Category": category,
            "Scope": scope,
            "Prepared_By": prepared_by,
            "Date": now_str(),
            "Revision_No": revision_no,
            "Dimming_Type": dimming_type,
        }
    )

    update_row_fields(queue_ws, queue_row_num, {
        "BOQ_ID": boq_id,
        "BOQ_Link": copied["webViewLink"],
        "Revision_No": revision_no,
        "Generated_File_Name": file_name,
        "Status": "Created",
        "Error_Message": "",
    })

    return {
        "success": True,
        "request_id": request_id_val,
        "lead_id": lead_id,
        "boq_id": boq_id,
        "revision_no": revision_no,
        "file_id": copied["id"],
        "boq_link": copied["webViewLink"],
        "generated_file_name": file_name,
    }


# ==========================================================
# GENERATE STAGE
# ==========================================================
def generate_architectural_boq(
    request_id: Optional[str],
    row_number: Optional[int],
    user_name: str
) -> Dict[str, Any]:
    _, queue_ws = get_ws_by_spreadsheet_name(
        CONFIG["crm_spreadsheet_name"],
        CONFIG["crm_boq_queue_sheet"]
    )
    queue_row_num, row = find_row_by_request_or_row(queue_ws, request_id=request_id, row_number=row_number)

    boq_link = safe_str(row.get("BOQ_Link"))
    boq_id = safe_str(row.get("BOQ_ID"))
    generated_file_name = safe_str(row.get("Generated_File_Name"))
    revision_no = int(float(row.get("Revision_No") or 1))
    request_id_val = safe_str(row.get("Request_ID"))

    file_id = parse_drive_id(boq_link)
    if not file_id:
        raise ValueError("BOQ file link missing. Run create first.")

    write_queue_processing(queue_ws, queue_row_num)

    price_map = load_arch_price_map()
    oem_map = load_oem_map()

    rows_out, grand_total = generate_arch_breakdown_rows(file_id, price_map, oem_map)
    write_arch_breakdown(file_id, rows_out, grand_total)
    write_summary(file_id, grand_total)

    write_queue_success(
        queue_ws,
        queue_row_num,
        boq_id=boq_id,
        boq_link=boq_link,
        revision_no=revision_no,
        generated_file_name=generated_file_name,
    )

    return {
        "success": True,
        "request_id": request_id_val,
        "boq_id": boq_id,
        "boq_link": boq_link,
        "rows_generated": len(rows_out),
        "grand_total": grand_total,
    }


# ==========================================================
# ONE-CLICK RUN
# ==========================================================
def run_architectural_boq(
    request_id: Optional[str],
    row_number: Optional[int],
    user_name: str
) -> Dict[str, Any]:
    created = create_architectural_boq_file(
        request_id=request_id,
        row_number=row_number,
        user_name=user_name
    )
    generated = generate_architectural_boq(
        request_id=request_id,
        row_number=row_number,
        user_name=user_name
    )
    return {
        "success": True,
        "create": created,
        "generate": generated,
    }


