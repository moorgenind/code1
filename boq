def get_or_create_subfolder(parent_folder_id: str, subfolder_name: str) -> Dict[str, str]:
    query = (
        f"'{parent_folder_id}' in parents and "
        f"name = '{subfolder_name}' and "
        f"mimeType = 'application/vnd.google-apps.folder' and trashed = false"
    )
    res = drive_service.files().list(q=query, fields="files(id,name,webViewLink)").execute()
    files = res.get("files", [])
    if files:
        return files[0]

    body = {
        "name": subfolder_name,
        "mimeType": "application/vnd.google-apps.folder",
        "parents": [parent_folder_id],
    }
    created = drive_service.files().create(
        body=body,
        fields="id,name,webViewLink"
    ).execute()
    return created


def copy_template_to_folder(template_file_id: str, target_folder_id: str, new_name: str) -> Dict[str, str]:
    body = {
        "name": new_name,
        "parents": [target_folder_id],
    }
    copied = drive_service.files().copy(
        fileId=template_file_id,
        body=body,
        fields="id,name,webViewLink"
    ).execute()
    return copied


