def now_str() -> str:
    return datetime.now().strftime("%d/%m/%Y")


def safe_str(v: Any) -> str:
    return "" if v is None else str(v).strip()


def clean_header(h: str) -> str:
    return str(h).strip()


def slugify(text: Any) -> str:
    text = safe_str(text)
    text = re.sub(r"[^A-Za-z0-9]+", "_", text)
    return text.strip("_")


def parse_drive_id(value: str) -> Optional[str]:
    value = safe_str(value)
    m = re.search(r"[-\w]{25,}", value)
    return m.group(0) if m else None


def get_ws_by_spreadsheet_name(spreadsheet_name: str, worksheet_name: str):
    ss = gc.open(spreadsheet_name)
    return ss, ss.worksheet(worksheet_name)


def get_ws_by_spreadsheet_id(spreadsheet_id: str, worksheet_name: str):
    ss = gc.open_by_key(spreadsheet_id)
    return ss, ss.worksheet(worksheet_name)


def get_headers(ws) -> List[str]:
    return [clean_header(h) for h in ws.row_values(1)]


def get_col_map(ws) -> Dict[str, int]:
    headers = get_headers(ws)
    return {h: i + 1 for i, h in enumerate(headers)}


def get_row_dict_by_row_number(ws, row_number: int) -> Dict[str, Any]:
    headers = get_headers(ws)
    values = ws.row_values(row_number)
    values += [""] * (len(headers) - len(values))
    return dict(zip(headers, values))


def update_row_fields(ws, row_number: int, updates: Dict[str, Any]):
    col_map = get_col_map(ws)
    cells = []
    for k, v in updates.items():
        if k not in col_map:
            continue
        c = ws.cell(row_number, col_map[k])
        c.value = v
        cells.append(c)
    if cells:
        ws.update_cells(cells, value_input_option="USER_ENTERED")


def find_row_by_request_or_row(
    ws,
    request_id: Optional[str] = None,
    row_number: Optional[int] = None
) -> Tuple[int, Dict[str, Any]]:
    if row_number:
        return row_number, get_row_dict_by_row_number(ws, row_number)

    if request_id:
        records = ws.get_all_records()
        for idx, row in enumerate(records, start=2):
            if safe_str(row.get("Request_ID")) == safe_str(request_id):
                return idx, row

    raise ValueError("Could not locate BOQ request row.")


