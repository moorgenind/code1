# REVISION LOGIC
# Based on BOQ_Request_Queue rows with same Lead_ID + Category
# ==========================================================
def next_revision_no(queue_ws, lead_id: str, category: str) -> int:
    records = queue_ws.get_all_records()
    max_rev = 0
    for row in records:
        if safe_str(row.get("Lead_ID")) != safe_str(lead_id):
            continue
        if safe_str(row.get("Category")) != safe_str(category):
            continue
        rev = safe_str(row.get("Revision_No"))
        if rev.isdigit():
            max_rev = max(max_rev, int(rev))
    return max_rev + 1


